# mig configuration. Copy to .env and fill in. All vars listed under
# "Required" must be set; missing/invalid ones cause mig to exit 1 on
# startup.

# ─── Required: owner ─────────────────────────────────────────────────
HOST_NAME=Jane Doe
HOST_EMAIL=jane@example.com
# IANA timezone — e.g. Europe/Berlin, America/New_York, Asia/Tokyo
HOST_TZ=Europe/Berlin

# ─── Required: meeting ──────────────────────────────────────────────
# Static URL embedded in every confirmation email. Supports Google Meet,
# Miratalk, Whereby, Jitsi, or any other meeting link.
MEETING_URL=https://meet.google.com/abc-defg-hij

# ─── Required: availability ─────────────────────────────────────────
# Comma-separated DAY HH:MM-HH:MM or DAY-DAY HH:MM-HH:MM
# Examples:
#   MON-FRI 09:00-17:00
#   MON-FRI 09:00-12:00,MON-FRI 14:00-18:00
#   MON 09:00-12:00,TUE-WED 14:00-18:00,FRI 09:00-15:00
WEEKLY_AVAILABILITY=MON-FRI 09:00-17:00
SLOT_DURATION_MIN=30

# ─── Required: security ─────────────────────────────────────────────
# 32+ random bytes. Generate with: openssl rand -base64 32
CANCEL_SECRET=replace-me-with-a-random-32-byte-secret

# ─── Required: SMTP ──────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=jane@example.com
# If the password contains spaces or shell-special characters
# (! $ & ` ' " < > | \ ;) wrap it in single quotes. Docker's env_file
# parser and mig's own .env parser both honour single quotes.
SMTP_PASS='replace-me'
# "Name <addr@example.com>" — wrap in single quotes (the angle
# brackets are not shell-safe in all parsers).
SMTP_FROM='Bookings <book@example.com>'

# ─── Required: public URL ───────────────────────────────────────────
# Absolute URL where mig is reachable. Used in confirmation/cancel links.
PUBLIC_URL=https://meet.example.com

# ─── Optional: timing ───────────────────────────────────────────────
# Min hours from now until first bookable slot
MIN_NOTICE_HOURS=6
# Max days ahead bookable
BOOKING_HORIZON_DAYS=14

# ─── Optional: blocked dates ────────────────────────────────────────
# Single dates or ranges. Both YYYY-MM-DD and DD.MM.YYYY accepted.
# Use .. or - to separate range endpoints.
# Examples:
#   2026-12-24,2026-12-25,2026-12-26
#   01.01.2027-10.01.2027
#   01.01.2027-10.01.2027,04.07.2027
# BLOCKED_DATES=

# ─── Optional: misc ─────────────────────────────────────────────────
# Max bookings per IP per 5 minutes
RATE_LIMIT_PER_5MIN=1
# light | dark | auto (default auto)
THEME=auto
# HTTP listen port (also the PORT inside the container)
PORT=8080
# Path to bookings JSON file
DATA_PATH=./data/bookings.json
# Set true to hide the "Powered by mig" footer + GitHub link
HIDE_BRANDING=false
# Override the GitHub URL the footer links to
GITHUB_URL=https://github.com/spy4x/mig
