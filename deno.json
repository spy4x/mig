{
  "nodeModulesDir": "manual",
  "tasks": {
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A --unstable-temporal _fresh/server.js",
    "check": "deno fmt --check . && deno lint . && deno check",
    "fmt": "deno fmt .",
    "lint": "deno lint .",
    "test": "deno test -A",
    "compile": "vite build && deno compile -A --no-check --unstable-temporal --include _fresh --exclude node_modules --output mig binary.ts",
    "smoke:binary": "deno run -A scripts/smoke-binary.ts",
    "typecheck": "deno check",
    "screenshots": "deno run -A --node-modules-dir=none --no-lock scripts/screenshots.ts",
    "embed:check": "deno run -A --node-modules-dir=none --no-lock scripts/embed-check.ts"
  },
  "lint": {
    "rules": {
      "tags": ["fresh", "recommended"],
      "exclude": ["react-no-danger"]
    }
  },
  "exclude": ["**/_fresh/*", "data/*", "!data/.gitkeep"],
  "imports": {
    "@/": "./",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "arktype": "npm:arktype@^2.2.3",
    "@spy4x/time": "jsr:@spy4x/time@1.6.0",
    "@spy4x/platform": "jsr:@spy4x/platform@1.6.0",
    "@spy4x/email": "jsr:@spy4x/email@1.6.0",
    "@spy4x/integrations": "jsr:@spy4x/integrations@1.6.0",
    "@spy4x/net": "jsr:@spy4x/net@1.6.0",
    "@spy4x/preact-signals": "jsr:@spy4x/preact-signals@0.1.5",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.18",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.8",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "preact-render-to-string": "npm:preact-render-to-string@^6.6.3",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "npm:@preact/signals@2.5.1": "npm:@preact/signals@^2.9.0",
    "tailwindcss": "npm:tailwindcss@^4.1.18",
    "vite": "npm:vite@^7.1.3"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"],
    "types": ["vite/client"]
  }
}
